APP_NAME=Katılım Analiz
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ALLOWED_HOSTS=localhost,127.0.0.1
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql+asyncpg://katilim:change-me@postgres:5432/katilim_analiz
# Production/institution deployments use a distinct DDL-capable role.
MIGRATION_DATABASE_URL=postgresql+asyncpg://katilim_migrator:change-me@postgres:5432/katilim_analiz
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
PRIVATE_RAW_DIR=data/private/raw
PUBLIC_DERIVED_DIR=datasets/derived
LOG_LEVEL=INFO
LOG_FORMAT=json

# rules_only | laptop | workstation
MODEL_PROFILE=rules_only
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_MODEL_DIGEST=2a654d98e6fba55d452b7043684e9b57a947e393bbffa62485a7aac05ee4eefd
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_CONTEXT=4096
MODEL_CONCURRENCY=1
MODEL_KEEP_ALIVE=-1
# Optional private directory that persists validated model answers across runs.
# Unset disables persistence; the in-process cache is always active.
MODEL_RESPONSE_CACHE_DIR=data/private/model-cache

# Collection is opt-in and restricted to the registry allowlist.
INGEST_NETWORK_ENABLED=false
INGEST_USER_AGENT=KatilimAnalizBot/0.1 (+local-competition-research; contact=configure-me)
INGEST_PER_HOST_DELAY_SECONDS=3
INGEST_MAX_BYTES=5000000
