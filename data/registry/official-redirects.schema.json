{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://katilim-analiz.local/schemas/official-redirects.schema.json",
  "title": "Observed official-bank redirect evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "registry_source_url",
    "observed_at",
    "method",
    "observations"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "registry_version": {"const": "2026-07-18.2"},
    "registry_source_url": {"const": "https://www.bddk.org.tr/Kurulus/Liste/77"},
    "observed_at": {"type": "string", "format": "date-time"},
    "method": {"type": "string", "minLength": 1},
    "observations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bank_id",
          "listed_homepage_url",
          "canonical_hosts_added",
          "verified_final_url",
          "probes",
          "note"
        ],
        "properties": {
          "bank_id": {"enum": ["albaraka-turk", "emlak-katilim"]},
          "listed_homepage_url": {"type": "string", "format": "uri"},
          "canonical_hosts_added": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "verified_final_url": {"type": "string", "format": "uri"},
          "probes": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "outcome", "http_status", "location"],
              "properties": {
                "url": {"type": "string", "format": "uri"},
                "outcome": {"enum": ["response", "connect_timeout"]},
                "http_status": {
                  "type": ["integer", "null"],
                  "minimum": 100,
                  "maximum": 599
                },
                "location": {"type": ["string", "null"]}
              }
            }
          },
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
