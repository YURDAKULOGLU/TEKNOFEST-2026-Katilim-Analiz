{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://katilim-analiz.local/schemas/bddk-participation-banks.schema.json",
  "title": "Versioned BDDK participation-bank source registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "registry_version",
    "source_observed_on",
    "source_url",
    "bank_count",
    "banks"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "registry_id": {"const": "bddk-participation-banks"},
    "registry_version": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.[1-9]\\d*$"},
    "source_observed_on": {"type": "string", "format": "date"},
    "source_url": {"const": "https://www.bddk.org.tr/Kurulus/Liste/77"},
    "bank_count": {"type": "integer", "const": 10},
    "banks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "listing_order",
          "legal_name",
          "listed_homepage_url",
          "allowed_hosts",
          "digital_bank"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "listing_order": {"type": "integer", "minimum": 1, "maximum": 10},
          "legal_name": {"type": "string", "minLength": 1},
          "listed_homepage_url": {"type": "string", "format": "uri"},
          "allowed_hosts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
            }
          },
          "digital_bank": {"type": "boolean"}
        }
      }
    }
  }
}
