{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://katilim-analiz.local/datasets/discovery-candidates.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "observed_at", "method", "banks"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "registry_version": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "method": {"type": "string", "minLength": 1},
    "banks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bank_id", "candidates"],
        "properties": {
          "bank_id": {"type": "string", "minLength": 1},
          "candidates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "kind", "discovery_source_url", "note"],
              "properties": {
                "url": {"type": "string", "format": "uri", "pattern": "^https://"},
                "kind": {"type": "string", "minLength": 1},
                "discovery_source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
                "note": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
