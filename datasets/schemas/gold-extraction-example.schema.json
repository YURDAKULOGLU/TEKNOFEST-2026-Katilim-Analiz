{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://katilim-analiz.local/datasets/gold-extraction-example.schema.json",
  "title": "One line of datasets/gold/extraction/<version>/examples.jsonl",
  "type": "object",
  "additionalProperties": false,
  "required": ["example_id", "category", "bank_id", "canonical_url", "blocks", "expected", "notes"],
  "properties": {
    "example_id": {"type": "string", "pattern": "^gold-[a-z0-9-]+$"},
    "category": {
      "enum": [
        "financing_product_sheet",
        "card_installment_title",
        "branded_points",
        "discount",
        "cashback",
        "fee_percent_trap",
        "ltv_table",
        "ambiguous_abstention",
        "prompt_injection"
      ]
    },
    "bank_id": {"type": "string", "minLength": 1},
    "canonical_url": {"type": "string", "format": "uri"},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text"],
        "properties": {
          "kind": {"enum": ["heading", "paragraph", "list_item", "table", "metadata", "other"]},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "product_family", "campaign_type", "rates", "terms", "financing_amounts", "fees", "rewards", "customer_segments"],
      "description": "Ground truth per field. null (or an empty list) states that the honest answer is abstention; measuring abstention is a first-class goal.",
      "properties": {
        "outcome": {"enum": ["candidate", "abstained"]},
        "product_family": {"type": ["string", "null"]},
        "campaign_type": {"type": ["string", "null"]},
        "rates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value_percent", "kind", "period", "term_months"],
            "properties": {
              "value_percent": {"type": "string"},
              "kind": {"type": "string"},
              "period": {"type": "string"},
              "term_months": {"type": ["integer", "null"]}
            }
          }
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minimum_months", "maximum_months"],
            "properties": {
              "minimum_months": {"type": ["integer", "null"]},
              "maximum_months": {"type": "integer"}
            }
          }
        },
        "financing_amounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["amount", "currency"],
            "properties": {
              "amount": {"type": "string"},
              "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
            }
          }
        },
        "fees": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "basis", "waived", "amount", "rate_percent"],
            "properties": {
              "kind": {"type": "string"},
              "basis": {"type": "string"},
              "waived": {"type": "boolean"},
              "amount": {"type": ["string", "null"]},
              "rate_percent": {"type": ["string", "null"]}
            }
          }
        },
        "rewards": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "amount", "points", "rate_percent"],
            "properties": {
              "kind": {"type": "string"},
              "amount": {"type": ["string", "null"]},
              "points": {"type": ["string", "null"]},
              "rate_percent": {"type": ["string", "null"]}
            }
          }
        },
        "customer_segments": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "notes": {"type": "string"}
  }
}
