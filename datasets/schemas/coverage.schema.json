{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://katilim-analiz.local/datasets/coverage.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "registry_source_url", "started_at", "completed_at", "collector_profile", "banks"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "registry_version": {"type": "string", "minLength": 1},
    "registry_source_url": {"type": "string", "format": "uri"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "collector_profile": {"type": "object"},
    "banks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bank_id", "bank_name", "observed_at", "source_url", "status", "reason", "source_count", "campaign_count", "attempts"],
        "properties": {
          "bank_id": {"type": "string", "minLength": 1},
          "bank_name": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "format": "date-time"},
          "source_url": {"type": "string", "format": "uri"},
          "status": {"enum": ["success", "not_found", "unreachable", "blocked"]},
          "reason": {"type": "string", "minLength": 1},
          "source_count": {"type": "integer", "minimum": 0},
          "campaign_count": {"type": "integer", "minimum": 0},
          "attempts": {"type": "array", "minItems": 1, "items": {"type": "object"}}
        }
      }
    }
  }
}
